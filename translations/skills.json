      "source": "Exanima.exe",
      "source_ids": [
        "exe:003126c0",
        "exe:00333e40"
      ],
      "status": "translated_not_visual_verified"
    },
    {
      "id": "skills.40",
      "en": "Cut or hook with your weapon after landing a blow.",
