    },
    {
      "id": "skills.38",
      "en": "Abandon your attack to quickly parry.",
      "zh": "中止攻击，迅速转为招架。",
      "source": "Exanima.exe",
      "source_ids": [
        "exe:00312660",
        "exe:00312798",
        "exe:00333de0"
      ],
      "status": "translated_not_visual_verified"
    },
    {
      "id": "skills.39",
      "en": "After a parry, rapidly follow with an attack.",
