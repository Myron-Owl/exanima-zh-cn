        "pwr_displace.pwr:1004",
        "pwr_energy.pwr:993",
        "pwr_mind.pwr:1922"
      ],
      "source": "powers",
      "status": "translated_not_visual_verified"
    },
    {
      "id": "powers.48",
      "en": "Take direct control of a target's actions.\r\n\r\nRequires Union, Continuity.",
      "zh": "直接控制目标的行动。\r\n\r\n需要：联合、持续。",
      "source_ids": [
        "pwr_displace.pwr:1083",
        "pwr_energy.pwr:1072",
        "pwr_mind.pwr:2001"
      ],
      "source": "powers",
      "status": "translated_not_visual_verified"
    },
    {
      "id": "powers.49",
      "en": "Cause a target to trust you for a short duration.",
      "zh": "使目标在短时间内信任你。",
      "source_ids": [
        "pwr_displace.pwr:1160",
        "pwr_energy.pwr:1149",
        "pwr_mind.pwr:2078"
      ],
      "source": "powers",
      "status": "translated_not_visual_verified"
    },
    {
      "id": "powers.50",
      "en": "Command the dead to repossess their remains in your service.\r\n\r\nRequires Continuity.",
      "zh": "命令亡者重返自己的遗骸，为你效力。\r\n\r\n需要：持续。",
