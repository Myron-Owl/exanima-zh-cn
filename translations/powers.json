        "pwr_energy.pwr:837",
        "pwr_mind.pwr:1766"
      ],
      "source": "powers",
      "status": "translated_not_visual_verified"
    },
    {
      "id": "powers.46",
      "en": "Render target suspicious of those they would otherwise trust.\r\n\r\nRequires Inversion.",
      "zh": "使目标对原本信任的人产生猜疑。\r\n\r\n需要：反转。",
