        "pwr_force.pwr:1352",
        "pwr_mind.pwr:1679"
      ],
      "source": "powers",
      "status": "translated_not_visual_verified"
    },
    {
      "id": "powers.45",
      "en": "Briefly confuse a target and cause them to not recognise others.",
      "zh": "短暂扰乱目标的心智，使其无法辨认他人。",
