        "pwr_energy.pwr:674",
        "pwr_mind.pwr:1603"
      ],
      "source": "powers",
      "status": "translated_not_visual_verified"
    },
    {
      "id": "powers.44",
      "en": "Continuously mask your mind from those that would sense it.\r\n\r\nRequires Continuity.",
      "zh": "持续屏蔽你的心智，避开他人的感知。\r\n\r\n需要：持续。",
      "source_ids": [
