        "pwr_displace.pwr:1213",
        "pwr_energy.pwr:1202",
        "pwr_mind.pwr:2131"
      ],
      "source": "powers",
      "status": "translated_not_visual_verified"
    },
    {
      "id": "powers.51",
      "en": "Focus your mind to leave your body and enter the spirit realm.\r\n\r\nRequires Coherence.",
      "zh": "集中心神，脱离肉身，进入灵界。\r\n\r\n需要：凝聚。",
      "source_ids": [
        "pwr_displace.pwr:1301",
        "pwr_energy.pwr:1290",
        "pwr_mind.pwr:2219"
      ],
      "source": "powers",
      "status": "translated_not_visual_verified"
    },
    {
      "id": "powers.52",
      "en": "Fully focus your mind to remain in spirit form indefinitely.\r\n\r\nRequires Revelation, Continuity.",
      "zh": "全神贯注，无限期地维持灵体形态。\r\n\r\n需要：启悟、持续。",
