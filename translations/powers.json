        "pwr_displace.pwr:916",
        "pwr_energy.pwr:905",
        "pwr_mind.pwr:1834"
      ],
      "source": "powers",
      "status": "translated_not_visual_verified"
    },
    {
      "id": "powers.47",
      "en": "Cause someone to trust you and follow your command.\r\n\r\nRequires Continuity.",
      "zh": "使目标信任你，并服从你的命令。\r\n\r\n需要：持续。",
