        "pwr_displace.pwr:1390",
        "pwr_energy.pwr:1379",
        "pwr_force.pwr:1653",
        "pwr_mind.pwr:2308"
      ],
      "source": "powers",
      "status": "translated_not_visual_verified"
    },
    {
      "id": "powers.53",
      "en": "Cleanse a target's mind of concerns and aggression.",
